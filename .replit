modules = ["nodejs-20", "rust-stable", "web"]

[[artifacts]]
id = "artifacts/trion-dashboard"

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "TRION L0 Daemon"

[[workflows.workflow]]
name = "TRION L0 Daemon"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace/trion-l0 && cargo run"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["openssl", "pkg-config"]

[userenv]

[userenv.shared]
ARBITRUM_RPC_URL = "https://arb-one.api.pocket.network"
RELAYER_PRIVATE_KEY = ""
ARBITRUM_SEPOLIA_RPC_URL = "https://sepolia-rollup.arbitrum.io/rpc"
TRION_RELAYER_ADDRESS = "0xdbbf66cad621da3ec186d18b29a135d2a5d42d20"
TRION_ORACLE_ADDRESS = "0x708193f93Fb897fbeA72e7e7D19237770F19E969"
ARBITRUM_SEPOLIA_RPC = "https://arbitrum-sepolia-rpc.publicnode.com"
TRION_V2_ORACLE_ADDRESS = "0x852365411bf700ba7257A93c134CBdE71A58d4E0"
TRION_V3_ORACLE_ADDRESS = "0xb819c63c02Ed5aB49017C0f3f2568A14624658b3"
TRION_PROTECTED_VAULT_ADDRESS = "0x91D7D8bc873D13B75E329e62D9dDA4EfF1b9f7E5"
